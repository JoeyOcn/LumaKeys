#!/bin/sh
# Midi Cat antes se llamaba MidiSky. Se quita la versión vieja para que
# Ableton no vea dos plugins iguales (los dos comparten el mismo código).
rm -rf "/Library/Audio/Plug-Ins/VST3/MidiSky.vst3" \
       "/Library/Audio/Plug-Ins/Components/MidiSky.component" \
       "/Applications/MidiSky.app"
CONSOLE_USER=$(stat -f %Su /dev/console 2>/dev/null)
if [ -n "$CONSOLE_USER" ] && [ "$CONSOLE_USER" != "root" ] && [ -d "/Users/$CONSOLE_USER/Library/Audio/Plug-Ins" ]; then
    rm -rf "/Users/$CONSOLE_USER/Library/Audio/Plug-Ins/VST3/MidiSky.vst3" \
           "/Users/$CONSOLE_USER/Library/Audio/Plug-Ins/Components/MidiSky.component"
fi
exit 0
